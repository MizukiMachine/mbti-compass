# MBTI Shadow Friend - Environment Variables

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# LLM (Optional; app falls back to deterministic MBTI nodes when omitted)
ANTHROPIC_API_KEY=your_zai_or_anthropic_compatible_key
LLM_MODEL=glm-5-turbo
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_TIMEOUT_MS=8000
